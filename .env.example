# ═══════════════════════════════════════════════════════
# Predict WorkNet Bot — Environment Config
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── Wallet ─────────────────────────────────────────
# Get this by running: awp-wallet unlock --duration 86400 --scope full --raw
AWP_WALLET_TOKEN=

# ── Agent ID ──────────────────────────────────────
# Your agent identifier (optional)
AGENT_ID=predict-worker

# ── Server ────────────────────────────────────────
# Don't change unless using dev/staging server
PREDICT_SERVER_URL=https://api.agentpredict.work

# ── Timing ────────────────────────────────────────
# Loop interval in seconds (default: 120)
INTERVAL=120

# ── Proxy (optional) ──────────────────────────────
# Uncomment and fill if using a proxy
# HTTP_PROXY=http://user:password@proxy.example.com:8080
# HTTPS_PROXY=http://user:password@proxy.example.com:8080

# ── OpenClaw (optional) ───────────────────────────
# Path to openclaw binary (auto-detected if in PATH)
# OPENCLAW_PATH=/path/to/openclaw
